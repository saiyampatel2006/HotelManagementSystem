@{
    ViewData["Title"] = "Concierge & Inquiries";
}

<div class="py-5 bg-cream border-bottom border-gold-subtle text-center">
    <div class="container py-3">
        <span class="text-gold text-uppercase fw-bold letter-spacing-2 small">At Your Service</span>
        <h1 class="display-4 font-serif fw-bold mt-1">Concierge & Inquiries</h1>
        <div class="gold-divider"><i class="bi bi-gem"></i></div>
        <p class="text-secondary max-w-700 mx-auto">
            Whether arranging helicopter transfers, bespoke dietary preferences, or private gala reservations, our royal concierge is available around the clock.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <h3 class="font-serif fw-bold mb-4">Direct Contact</h3>
            <div class="d-flex gap-3 mb-4">
                <div class="kpi-icon flex-shrink-0"><i class="bi bi-geo-alt"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Estate Location</h6>
                    <p class="text-secondary small mb-0">700 Luxury Boulevard, Suite A, Grand Aurelia Coast</p>
                </div>
            </div>
            <div class="d-flex gap-3 mb-4">
                <div class="kpi-icon flex-shrink-0"><i class="bi bi-telephone"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Telephone & Limousine Desk</h6>
                    <p class="text-secondary small mb-0">+1 (800) 555-AURELIA / +1 (800) 555-0199</p>
                </div>
            </div>
            <div class="d-flex gap-3 mb-4">
                <div class="kpi-icon flex-shrink-0"><i class="bi bi-envelope"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Electronic Inquiries</h6>
                    <p class="text-secondary small mb-0">concierge@grandaurelia.com</p>
                </div>
            </div>
            <div class="d-flex gap-3 mb-4">
                <div class="kpi-icon flex-shrink-0"><i class="bi bi-clock"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Operational Hours</h6>
                    <p class="text-secondary small mb-0">Concierge Desk: 24 Hours / 7 Days a Week</p>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="p-4 p-lg-5 bg-white rounded border border-gold-subtle shadow-sm">
                <h4 class="font-serif fw-bold mb-3">Send a Concierge Request</h4>
                <form asp-controller="Home" asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Your Name</label>
                            <input type="text" name="name" class="form-control" required placeholder="Lord / Lady / Mr. / Ms." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="email" class="form-control" required placeholder="guest@example.com" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Phone / WhatsApp</label>
                            <input type="tel" name="phone" class="form-control" placeholder="+1 (555) 000-0000" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">How May We Assist You?</label>
                            <textarea name="message" class="form-control" rows="4" required placeholder="Specify your desired stay dates, suite preferences, or dining requirements..."></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-gold w-100 py-2">
                                <i class="bi bi-send me-1"></i> Transmit Request to Concierge
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

