@{
    ViewData["Title"] = "Privacy & Guest Confidentiality";
}

<div class="py-5 bg-cream border-bottom border-gold-subtle text-center">
    <div class="container py-3">
        <span class="text-gold text-uppercase fw-bold letter-spacing-2 small">Trust & Discretion</span>
        <h1 class="display-4 font-serif fw-bold mt-1">Guest Privacy Charter</h1>
        <div class="gold-divider"><i class="bi bi-gem"></i></div>
    </div>
</div>

<div class="container py-5 max-w-700">
    <div class="p-4 p-md-5 bg-white rounded border border-gold-subtle shadow-sm">
        <h4 class="font-serif fw-bold mb-3">Commitment to Total Discretion</h4>
        <p class="text-secondary">
            At The Aurelia Grand Hotel & Suites, discretion is the hallmark of luxury. All guest registration records, reservation itineraries, and billing transactions are guarded with industry-standard cryptographic encryption.
        </p>
        <h5 class="font-serif fw-bold mt-4 mb-2">Data Protection Standard</h5>
        <p class="text-secondary small">
            We do not monetize or share guest itineraries with third-party advertisers. All payment authorizations are processed through secure simulated tokenized gateways with zero storage of raw CVV or magnetic stripe credentials.
        </p>
        <h5 class="font-serif fw-bold mt-4 mb-2">College Project Notice</h5>
        <p class="text-secondary small">
            This deployment is configured as an academic demonstration for third-year B.Tech CSE (AIML) evaluation. Demo card credentials and fake profiles used for testing are strictly simulated in-memory and in the project database.
        </p>
    </div>
</div>
