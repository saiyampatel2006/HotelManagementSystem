@{
    ViewData["Title"] = "About The Aurelia Grand";
}

<!-- Page Header -->
<div class="py-5 bg-cream border-bottom border-gold-subtle text-center">
    <div class="container py-3">
        <span class="text-gold text-uppercase fw-bold letter-spacing-2 small">Heritage & Philosophy</span>
        <h1 class="display-4 font-serif fw-bold mt-1">A Century of Grandeur</h1>
        <div class="gold-divider"><i class="bi bi-gem"></i></div>
        <p class="text-secondary max-w-700 mx-auto">
            Founded with an enduring devotion to classical craftsmanship and aristocratic hospitality.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5 align-items-center mb-5">
        <div class="col-lg-6">
            <span class="text-gold text-uppercase fw-bold small">Architectural Masterpiece</span>
            <h2 class="font-serif fw-bold mb-3">Designed for Discerning Connoisseurs</h2>
            <p class="text-secondary">
                The Aurelia Grand stands as an architectural tribute to Mediterranean classicism and contemporary luxury. Built with hand-cut limestone arches, Italian Calacatta marble corridors, and custom brass fixtures, each corridor tells a story of refined luxury.
            </p>
            <p class="text-secondary">
                Our bespoke accommodations are intentionally limited in number to guarantee absolute privacy, individualized concierge attention, and an unhurried, discreet residential atmosphere.
            </p>
            <div class="row g-3 pt-3">
                <div class="col-6">
                    <div class="border-start border-3 border-warning ps-3">
                        <h4 class="fw-bold font-serif mb-0 text-dark">100%</h4>
                        <small class="text-secondary">Soundproof Suites</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="border-start border-3 border-warning ps-3">
                        <h4 class="fw-bold font-serif mb-0 text-dark">1:1</h4>
                        <small class="text-secondary">Dedicated Staff Ratio</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="rounded overflow-hidden shadow-lg border border-gold-subtle">
                <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1000&q=80" alt="Hotel Architecture" class="img-fluid" />
            </div>
        </div>
    </div>

    <!-- College Project Architecture Specification Section -->
    <div class="p-4 p-lg-5 bg-white rounded border border-gold-subtle shadow-sm my-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-gold-light text-gold-dark px-3 py-1 text-uppercase fw-bold small mb-2">College Project Specification</span>
                <h3 class="font-serif fw-bold mb-2">Full-Stack Enterprise Hotel Management System</h3>
                <p class="text-secondary mb-3">
                    Developed for a 3rd-year B.Tech Computer Science & Engineering (AIML) curriculum. This solution features a decoupled Service Layer architecture, ASP.NET Core Identity RBAC security, Entity Framework Core relational data modeling, prevention of overlapping date reservations, and an AI-driven dynamic pricing heuristic.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-cream text-dark border">ASP.NET Core 8 MVC</span>
                    <span class="badge bg-cream text-dark border">C# 12</span>
                    <span class="badge bg-cream text-dark border">Entity Framework Core 8</span>
                    <span class="badge bg-cream text-dark border">SQL Server</span>
                    <span class="badge bg-cream text-dark border">Bootstrap 5</span>
                    <span class="badge bg-cream text-dark border">Chart.js Analytics</span>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <a asp-controller="Rooms" asp-action="Index" class="btn btn-gold">
                    Experience Live Booking Engine <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

