@model ReportsViewModel
@{
    ViewData["Title"] = "Financial & Occupancy Reports";
}

<div class="py-4 bg-cream border-bottom border-gold-subtle">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Reports</li>
                </ol>
            </nav>
            <h1 class="display-6 font-serif fw-bold mb-0">Financial & Operational Analytics</h1>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Reports" asp-action="ExportCsv" 
               asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
               asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
               class="btn btn-gold btn-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> Export to CSV
            </a>
            <button type="button" class="btn btn-ivory btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Print Statement
            </button>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Date Range Filter -->
    <div class="p-3 bg-white rounded border border-gold-subtle shadow-sm mb-4">
        <form asp-controller="Reports" asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Report Period Start</label>
                    <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Report Period End</label>
                    <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-gold w-100">
                        <i class="bi bi-filter"></i> Generate Analytics
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- KPI Summary Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="kpi-card h-100">
                <span class="kpi-title">Gross Revenue</span>
                <div class="kpi-value text-gold-dark">$@Model.GrossRevenue.ToString("N2")</div>
                <small class="text-secondary">Before tax deductions</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card h-100">
                <span class="kpi-title">Luxury Cess & Taxes</span>
                <div class="kpi-value text-secondary">$@Model.TaxCollected.ToString("N2")</div>
                <small class="text-secondary">12% GST/Luxury levy</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card h-100">
                <span class="kpi-title">Net Room Receipts</span>
                <div class="kpi-value text-success">$@Model.NetRevenue.ToString("N2")</div>
                <small class="text-secondary">Net operating hotel yield</small>
            </div>
        </div>
    </div>

    <!-- Booking Volume Metrics -->
    <div class="p-4 bg-white rounded border border-gold-subtle shadow-sm mb-5">
        <h5 class="font-serif fw-bold mb-3">Reservation Volume in Window</h5>
        <div class="row g-3 text-center">
            <div class="col-3 border-end">
                <small class="text-secondary d-block">Total Requests</small>
                <strong class="font-serif fs-4 text-dark">@Model.TotalBookings</strong>
            </div>
            <div class="col-3 border-end">
                <small class="text-secondary d-block">Active / Confirmed</small>
                <strong class="font-serif fs-4 text-primary">@Model.ConfirmedBookings</strong>
            </div>
            <div class="col-3 border-end">
                <small class="text-secondary d-block">Completed Stays</small>
                <strong class="font-serif fs-4 text-success">@Model.CompletedStays</strong>
            </div>
            <div class="col-3">
                <small class="text-secondary d-block">Cancelled</small>
                <strong class="font-serif fs-4 text-danger">@Model.CancelledBookings</strong>
            </div>
        </div>
    </div>

    <!-- Category Performance Breakdown Table -->
    <div class="p-4 bg-white rounded border border-gold-subtle shadow-sm mb-5">
        <h5 class="font-serif fw-bold mb-3">Revenue Performance by Suite Category</h5>
        <div class="table-responsive">
            <table class="table hotel-table mb-0">
                <thead>
                    <tr>
                        <th>Suite Category</th>
                        <th class="text-center">Bookings Count</th>
                        <th class="text-center">Total Nights Sold</th>
                        <th class="text-end">Gross Tariff</th>
                        <th class="text-end">Revenue Share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model.CategoryBreakdown)
                    {
                        <tr>
                            <td><strong>@cat.CategoryName</strong></td>
                            <td class="text-center">@cat.BookingCount</td>
                            <td class="text-center">@cat.TotalNightsBooked nights</td>
                            <td class="text-end fw-semibold">$@cat.TotalRevenue.ToString("N2")</td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <div class="progress" style="width: 80px; height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @cat.PercentageOfRevenue%"></div>
                                    </div>
                                    <span class="small font-monospace">@cat.PercentageOfRevenue%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detailed Ledger Records -->
    <div class="p-4 bg-white rounded border border-gold-subtle shadow-sm">
        <h5 class="font-serif fw-bold mb-3">Audited Booking Ledger (@Model.ReportBookings.Count() Records)</h5>
        <div class="table-responsive">
            <table class="table hotel-table mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Guest</th>
                        <th>Suite</th>
                        <th>Dates</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.ReportBookings)
                    {
                        <tr>
                            <td><strong class="font-serif text-gold-dark">@b.BookingReference</strong></td>
                            <td>@(b.User?.FullName ?? "N/A")</td>
                            <td>Suite @b.Room?.RoomNumber (@b.Room?.RoomType?.Name)</td>
                            <td>@b.CheckInDate.ToString("yyyy-MM-dd") to @b.CheckOutDate.ToString("yyyy-MM-dd")</td>
                            <td><strong>$@b.TotalPrice.ToString("N2")</strong></td>
                            <td>
                                @if (b.Status == BookingStatus.Confirmed)
                                {
                                    <span class="badge badge-booking-confirmed">Confirmed</span>
                                }
                                else if (b.Status == BookingStatus.CheckedIn)
                                {
                                    <span class="badge badge-booking-checkedin">In House</span>
                                }
                                else if (b.Status == BookingStatus.CheckedOut)
                                {
                                    <span class="badge badge-booking-checkedout">Completed</span>
                                }
                                else
                                {
                                    <span class="badge badge-booking-cancelled">Cancelled</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

