@model BookingCreateViewModel
@{
    ViewData["Title"] = $"Reserve {Model.RoomTypeName} #{Model.RoomNumber}";
}

<div class="py-4 bg-cream border-bottom border-gold-subtle">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Rooms" asp-action="Index">Suites</a></li>
                <li class="breadcrumb-item"><a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.RoomId">Suite @Model.RoomNumber</a></li>
                <li class="breadcrumb-item active" aria-current="page">Reservation</li>
            </ol>
        </nav>
        <h1 class="font-serif fw-bold h2 mb-0">Complete Your Suite Reservation</h1>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <!-- Form Column -->
        <div class="col-lg-8">
            <div class="p-4 p-md-5 bg-white rounded border border-gold-subtle shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom border-gold-subtle">
                    <i class="bi bi-calendar2-range text-gold fs-4"></i>
                    <div>
                        <h4 class="font-serif fw-bold mb-0">Stay Itinerary & Guest Details</h4>
                        <small class="text-secondary">Please confirm your dates and party information</small>
                    </div>
                </div>

                <form asp-controller="Bookings" asp-action="Create" method="post" id="bookingForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RoomId" />
                    <input type="hidden" id="bookingNightlyRate" data-rate="@Model.PricePerNight" value="@Model.PricePerNight" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Date Selection with Realtime Validation -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CheckInDate" class="form-label"></label>
                            <input asp-for="CheckInDate" class="form-control" type="date" id="bookingCheckIn" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CheckOutDate" class="form-label"></label>
                            <input asp-for="CheckOutDate" class="form-control" type="date" id="bookingCheckOut" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Party Size -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Adults" class="form-label"></label>
                            <select asp-for="Adults" class="form-select">
                                @for (int i = 1; i <= Math.Min(6, Model.RoomCapacity > 0 ? Model.RoomCapacity : 4); i++)
                                {
                                    <option value="@i">@i Adult@(i > 1 ? "s" : "")</option>
                                }
                            </select>
                            <span asp-validation-for="Adults" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Children" class="form-label"></label>
                            <select asp-for="Children" class="form-select">
                                <option value="0">None</option>
                                <option value="1">1 Child</option>
                                <option value="2">2 Children</option>
                            </select>
                            <span asp-validation-for="Children" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Special Requests -->
                    <div class="mb-4">
                        <label asp-for="SpecialRequests" class="form-label"></label>
                        <textarea asp-for="SpecialRequests" class="form-control" rows="3" placeholder="Airport limousine pickup flight details, dietary requirements, champagne preferences, or quiet floor requests..."></textarea>
                        <span asp-validation-for="SpecialRequests" class="text-danger small"></span>
                        <small class="text-muted">Special requests are fulfilled subject to availability upon arrival.</small>
                    </div>

                    <!-- Luxury Policies Agreement -->
                    <div class="p-3 bg-cream rounded border border-gold-subtle mb-4 small text-secondary">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="policyAgree" required checked>
                            <label class="form-check-label" for="policyAgree">
                                I acknowledge that check-in begins at 14:00 and check-out is at 12:00. Cancellations received 48 hours prior to check-in are eligible for a 100% refund.
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-3 fs-6">
                        <i class="bi bi-credit-card-2-front me-2"></i> Confirm Itinerary & Proceed to Payment
                    </button>
                </form>
            </div>
        </div>

        <!-- Sticky Suite Summary Column -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px;">
                <div class="hotel-card">
                    <div class="hotel-card-img-wrapper" style="height: 180px;">
                        <img src="@Model.RoomImageUrl" alt="@Model.RoomTypeName" />
                        <span class="hotel-badge-ribbon">@Model.RoomTypeName</span>
                    </div>

                    <div class="p-4">
                        <h4 class="font-serif fw-bold mb-1">Suite @Model.RoomNumber</h4>
                        <p class="text-secondary small mb-3">@Model.RoomTypeName</p>

                        <div class="py-3 border-top border-bottom border-gold-subtle my-3">
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-secondary">Nightly Tariff:</span>
                                <strong>$@Model.PricePerNight.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-secondary">Total Nights:</span>
                                <strong><span id="displayNights">@Model.TotalNights</span> Night(s)</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-secondary">Room Charges:</span>
                                <span id="displaySubtotal">$@Model.SubTotal.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-secondary">Taxes & Cess (12%):</span>
                                <span id="displayTax">$@Model.TaxAmount.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold fs-6 text-dark">Total Payable:</span>
                            <span class="font-serif fs-4 fw-bold text-gold-dark" id="displayTotal">
                                $@Model.TotalPrice.ToString("N2")
                            </span>
                        </div>

                        <div class="text-center text-muted small">
                            <i class="bi bi-shield-lock-fill text-gold me-1"></i> 256-Bit SSL Encrypted Reservation
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

