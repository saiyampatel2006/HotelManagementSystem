@model RoomDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Room.RoomType?.Name} - Suite {Model.Room.RoomNumber}";
}

<!-- Page Header -->
<div class="py-4 bg-cream border-bottom border-gold-subtle">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Rooms" asp-action="Index">Suites & Villas</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Suite @Model.Room.RoomNumber</li>
                </ol>
            </nav>
            <h1 class="font-serif fw-bold h2 mb-0">Suite @Model.Room.RoomNumber — @Model.Room.RoomType?.Name</h1>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center gap-3">
            <div class="text-end">
                <span class="d-block small text-muted">Nightly Tariff</span>
                <span class="fs-3 fw-bold font-serif text-gold-dark">$@Model.Room.PricePerNight.ToString("N0")</span>
            </div>
            <a href="#bookingSidebar" class="btn btn-gold">
                <i class="bi bi-calendar-check me-1"></i> Reserve Suite
            </a>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <!-- Main Details Column -->
        <div class="col-lg-8">
            <!-- Showcase Image -->
            <div class="rounded overflow-hidden shadow-sm border border-gold-subtle mb-4" style="height: 480px;">
                <img src="@Model.Room.ImageUrl" alt="@Model.Room.RoomType?.Name" class="w-100 h-100 object-fit-cover" />
            </div>

            <!-- Key Quick Specs -->
            <div class="p-4 bg-white rounded border border-gold-subtle mb-4 shadow-sm">
                <div class="row g-3 text-center">
                    <div class="col-3 border-end">
                        <small class="text-secondary d-block">Suite Number</small>
                        <strong class="font-serif fs-5 text-dark">#@Model.Room.RoomNumber</strong>
                    </div>
                    <div class="col-3 border-end">
                        <small class="text-secondary d-block">Max Occupancy</small>
                        <strong class="font-serif fs-5 text-dark">@Model.Room.Capacity Guests</strong>
                    </div>
                    <div class="col-3 border-end">
                        <small class="text-secondary d-block">Floor Level</small>
                        <strong class="font-serif fs-5 text-dark">Floor @Model.Room.FloorNumber</strong>
                    </div>
                    <div class="col-3">
                        <small class="text-secondary d-block">Status</small>
                        <strong class="font-serif fs-5 text-success">@Model.Room.Status</strong>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="mb-5">
                <h3 class="font-serif fw-bold mb-3">Suite Overview</h3>
                <p class="text-secondary lead" style="font-size: 1.05rem;">
                    @Model.Room.Description
                </p>
                <p class="text-secondary">
                    @Model.Room.RoomType?.Description
                </p>
            </div>

            <!-- Amenities & Facilities -->
            <div class="mb-5">
                <h3 class="font-serif fw-bold mb-3">Included Luxury Facilities</h3>
                <div class="row g-3">
                    @foreach (var rf in Model.Room.RoomFacilities)
                    {
                        <div class="col-md-6">
                            <div class="p-3 bg-white rounded border border-gold-subtle d-flex align-items-center gap-3">
                                <div class="bg-gold-light text-gold-dark rounded p-2 fs-5">
                                    <i class="bi @rf.Facility.IconClass"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">@rf.Facility.Name</h6>
                                    <small class="text-secondary">@rf.Facility.Description</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Guest Reviews Section -->
            <div class="mt-5 pt-4 border-top border-gold-subtle">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="font-serif fw-bold mb-0">Guest Reviews (@Model.Reviews.Count())</h3>
                    <div class="text-warning">
                        <i class="bi bi-star-fill text-gold"></i>
                        <span class="text-dark fw-bold ms-1">4.9 / 5.0 Rating</span>
                    </div>
                </div>

                @if (Model.Reviews.Any())
                {
                    <div class="d-flex flex-column gap-3 mb-4">
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="p-4 bg-white rounded border border-gold-subtle">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-gold-light text-gold-dark rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px;">
                                            @(review.User?.FullName?.Length > 0 ? review.User.FullName[0].ToString() : "G")
                                        </div>
                                        <div>
                                            <strong class="d-block text-dark small">@(review.User?.FullName ?? "Grand Guest")</strong>
                                            <small class="text-muted" style="font-size: 0.75rem;">@review.CreatedAt.ToString("MMMM dd, yyyy")</small>
                                        </div>
                                    </div>
                                    <div class="text-warning">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill text-gold small"></i>
                                        }
                                    </div>
                                </div>
                                <p class="text-secondary small mb-0 font-serif fst-italic">
                                    "@review.Comment"
                                </p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 bg-white rounded border border-gold-subtle text-center text-muted mb-4">
                        No reviews yet for this suite. Be among the first to experience and review this accommodation!
                    </div>
                }

                <!-- Leave a Review Form -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="p-4 bg-cream rounded border border-gold-subtle">
                        <h5 class="font-serif fw-bold mb-3">Share Your Experience</h5>
                        <form asp-controller="Rooms" asp-action="AddReview" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roomId" value="@Model.Room.Id" />
                            <div class="mb-3">
                                <label class="form-label">Rating</label>
                                <select name="rating" class="form-select w-auto">
                                    <option value="5">★★★★★ (5 Stars - Exceptional)</option>
                                    <option value="4">★★★★☆ (4 Stars - Very Good)</option>
                                    <option value="3">★★★☆☆ (3 Stars - Average)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Your Review</label>
                                <textarea name="comment" class="form-control" rows="3" required placeholder="Describe your stay, comfort, butler service, or ambience..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-gold btn-sm">
                                Submit Guest Review
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="p-3 bg-light rounded text-center small text-secondary">
                        Please <a asp-controller="Account" asp-action="Login" class="text-gold fw-bold">Sign In</a> to share your feedback about this suite.
                    </div>
                }
            </div>
        </div>

        <!-- Sticky Reservation Sidebar -->
        <div class="col-lg-4" id="bookingSidebar">
            <div class="sticky-top" style="top: 100px;">
                <div class="p-4 bg-white rounded border border-gold-subtle shadow-md">
                    <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom border-gold-subtle">
                        <div>
                            <span class="text-muted small">Tariff</span>
                            <h3 class="font-serif fw-bold text-gold-dark mb-0">$@Model.Room.PricePerNight.ToString("N0")</h3>
                        </div>
                        <span class="badge bg-gold-light text-gold-dark border border-gold-subtle py-2 px-3">
                            <i class="bi bi-shield-check me-1"></i> Best Rate Guarantee
                        </span>
                    </div>

                    <!-- Availability indicator for selected search dates -->
                    <div class="mb-4">
                        @if (Model.IsAvailableForSelectedDates)
                        {
                            <div class="alert alert-success d-flex align-items-center gap-2 py-2 mb-0" role="alert" style="font-size: 0.85rem;">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Suite is available for your dates!</span>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-0" role="alert" style="font-size: 0.85rem;">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>Reserved for selected dates. Try other dates.</span>
                            </div>
                        }
                    </div>

                    <!-- Quick Booking Pre-calculation -->
                    <div class="bg-cream p-3 rounded border border-gold-subtle mb-4 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Check-In:</span>
                            <strong>@Model.CheckIn.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Check-Out:</span>
                            <strong>@Model.CheckOut.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Duration:</span>
                            <strong>@Model.TotalNights night(s)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Room Charges:</span>
                            <span>$@((Model.Room.PricePerNight * Model.TotalNights).ToString("N2"))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Taxes & Luxury Fee (12%):</span>
                            <span>$@(((Model.Room.PricePerNight * Model.TotalNights) * 0.12m).ToString("N2"))</span>
                        </div>
                        <div class="d-flex justify-content-between pt-2 mt-2 border-top border-gold-subtle fw-bold fs-6 text-dark">
                            <span>Estimated Total:</span>
                            <span class="text-gold-dark">$@Model.EstimatedTotal.ToString("N2")</span>
                        </div>
                    </div>

                    <a asp-controller="Bookings" asp-action="Create" 
                       asp-route-roomId="@Model.Room.Id"
                       asp-route-checkIn="@Model.CheckIn.ToString("yyyy-MM-dd")"
                       asp-route-checkOut="@Model.CheckOut.ToString("yyyy-MM-dd")"
                       asp-route-guests="@Model.Guests"
                       class="btn btn-gold w-100 py-3 fs-6">
                        <i class="bi bi-lock-fill me-1"></i> Proceed to Reservation
                    </a>

                    <div class="mt-3 text-center text-muted" style="font-size: 0.78rem;">
                        <i class="bi bi-check2 text-gold me-1"></i> No immediate charge required to view details.<br />
                        <i class="bi bi-arrow-counterclockwise text-gold me-1"></i> Free cancellation up to 48 hours before check-in.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

