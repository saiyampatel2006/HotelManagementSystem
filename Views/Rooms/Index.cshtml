@model RoomSearchViewModel
@{
    ViewData["Title"] = "Suites & Villas Collection";
}

<!-- Page Header -->
<div class="py-5 bg-cream border-bottom border-gold-subtle text-center">
    <div class="container py-3">
        <span class="text-gold text-uppercase fw-bold letter-spacing-2 small">The Grand Residence Collection</span>
        <h1 class="display-4 font-serif fw-bold mt-1">Our Accommodations</h1>
        <div class="gold-divider"><i class="bi bi-gem"></i></div>
        <p class="text-secondary max-w-700 mx-auto">
            Discover your sanctuary of quiet luxury, crafted with bespoke Italian marble, private terraces, and signature cloud bedding.
        </p>
    </div>
</div>

<div class="container py-5">
    <!-- AI Recommendation Banner if triggered -->
    @if (!string.IsNullOrEmpty(Model.AiRecommendationNote))
    {
        <div class="aiml-badge-box mb-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-cpu fs-3 text-gold"></i>
                <div>
                    <strong class="text-dark">AIML Predictive Recommendation:</strong>
                    <div class="text-secondary small">@Model.AiRecommendationNote</div>
                </div>
            </div>
        </div>
    }

    <!-- Search & Filter Controls -->
    <div class="p-4 bg-white rounded border border-gold-subtle shadow-sm mb-5">
        <form asp-controller="Rooms" asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label">Check-In</label>
                    <input type="date" name="CheckIn" class="form-control" value="@(Model.CheckIn?.ToString("yyyy-MM-dd"))" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label">Check-Out</label>
                    <input type="date" name="CheckOut" class="form-control" value="@(Model.CheckOut?.ToString("yyyy-MM-dd"))" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label">Suite Type</label>
                    <select name="RoomTypeId" class="form-select">
                        <option value="">All Types</option>
                        @foreach (var type in Model.RoomTypes)
                        {
                            <option value="@type.Id" selected="@(Model.RoomTypeId == type.Id)">@type.Name</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label">Guests</label>
                    <select name="Guests" class="form-select">
                        <option value="">Any Capacity</option>
                        <option value="1" selected="@(Model.Guests == 1)">1 Guest</option>
                        <option value="2" selected="@(Model.Guests == 2)">2 Guests</option>
                        <option value="3" selected="@(Model.Guests == 3)">3 Guests</option>
                        <option value="4" selected="@(Model.Guests == 4)">4 Guests</option>
                        <option value="5" selected="@(Model.Guests >= 5)">5+ Guests</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label">Sort By</label>
                    <select name="SortBy" class="form-select">
                        <option value="">Default</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                        <option value="capacity" selected="@(Model.SortBy == "capacity")">Max Capacity</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 col-6 d-flex gap-2">
                    <button type="submit" class="btn btn-gold w-100 py-2">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <a asp-controller="Rooms" asp-action="Index" class="btn btn-ivory py-2" title="Reset Filters">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Rooms Results Grid -->
    <div class="row g-4">
        @if (Model.Rooms.Any())
        {
            foreach (var room in Model.Rooms)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="hotel-card h-100 d-flex flex-column">
                        <div class="hotel-card-img-wrapper">
                            <img src="@room.ImageUrl" alt="@room.RoomType?.Name" loading="lazy" />
                            <span class="hotel-badge-ribbon">@room.RoomType?.Name</span>
                            <div class="hotel-badge-price">
                                <span class="text-gold-dark font-serif fs-5 fw-bold">$@room.PricePerNight.ToString("N0")</span>
                                <small class="text-muted fw-normal">/ night</small>
                            </div>
                        </div>

                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="font-serif fw-bold mb-0">Suite @room.RoomNumber</h4>
                                @if (room.Status == RoomStatus.Available)
                                {
                                    <span class="badge badge-status-available">Available</span>
                                }
                                else if (room.Status == RoomStatus.Booked)
                                {
                                    <span class="badge badge-status-booked">Reserved</span>
                                }
                                else if (room.Status == RoomStatus.Maintenance)
                                {
                                    <span class="badge badge-status-maintenance">Maintenance</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-cleaning">Housekeeping</span>
                                }
                            </div>

                            <p class="text-secondary small mb-3">
                                @room.Description
                            </p>

                            <!-- Facility Chips -->
                            <div class="mb-4">
                                @foreach (var rf in room.RoomFacilities.Take(3))
                                {
                                    <span class="facility-pill">
                                        <i class="bi @rf.Facility.IconClass"></i> @rf.Facility.Name
                                    </span>
                                }
                                @if (room.RoomFacilities.Count > 3)
                                {
                                    <span class="facility-pill text-gold">+@(room.RoomFacilities.Count - 3) more</span>
                                }
                            </div>

                            <div class="mt-auto pt-3 border-top border-gold-subtle d-flex justify-content-between align-items-center">
                                <span class="small text-secondary">
                                    <i class="bi bi-people text-gold me-1"></i> @room.Capacity Guests • Floor @room.FloorNumber
                                </span>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Rooms" asp-action="Details" 
                                       asp-route-id="@room.Id" 
                                       asp-route-checkIn="@Model.CheckIn?.ToString("yyyy-MM-dd")"
                                       asp-route-checkOut="@Model.CheckOut?.ToString("yyyy-MM-dd")"
                                       class="btn btn-ivory btn-sm">
                                        Details
                                    </a>
                                    @if (room.Status == RoomStatus.Available)
                                    {
                                        <a asp-controller="Bookings" asp-action="Create" 
                                           asp-route-roomId="@room.Id" 
                                           asp-route-checkIn="@Model.CheckIn?.ToString("yyyy-MM-dd")"
                                           asp-route-checkOut="@Model.CheckOut?.ToString("yyyy-MM-dd")"
                                           asp-route-guests="@Model.Guests"
                                           class="btn btn-gold btn-sm">
                                            Book Now
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 py-5 text-center bg-white rounded border border-gold-subtle">
                <i class="bi bi-search fs-1 text-gold mb-3 d-block"></i>
                <h4 class="font-serif fw-bold">No Suites Match Your Precise Criteria</h4>
                <p class="text-secondary small mb-4">Try relaxing your date window, price range, or guest count to view available luxury residences.</p>
                <a asp-controller="Rooms" asp-action="Index" class="btn btn-gold">
                    Clear All Filters
                </a>
            </div>
        }
    </div>
</div>

