@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Guest Directory";
}

<div class="py-4 bg-cream border-bottom border-gold-subtle">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Guest Directory</li>
                </ol>
            </nav>
            <h1 class="display-6 font-serif fw-bold mb-0">Registered Guest Directory</h1>
        </div>
        <div class="mt-3 mt-md-0">
            <span class="badge bg-gold-light text-gold-dark border border-gold-subtle p-2 fs-6">
                <i class="bi bi-people me-1"></i> @Model.Count() Registered Patrons
            </span>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="p-4 bg-white rounded border border-gold-subtle shadow-sm">
        <div class="table-responsive">
            <table class="table hotel-table mb-0">
                <thead>
                    <tr>
                        <th>Guest Patron</th>
                        <th>Email Address</th>
                        <th>Contact Number</th>
                        <th>Location / Address</th>
                        <th>Enrolled Date</th>
                        <th class="text-center">Total Stays</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-gold-light text-gold-dark rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                        @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "G")
                                    </div>
                                    <div>
                                        <strong class="text-dark">@user.FullName</strong>
                                    </div>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>@(user.PhoneNumber ?? "—")</td>
                            <td><small class="text-secondary">@(user.Address ?? "Not specified")</small></td>
                            <td><small class="text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                            <td class="text-center">
                                <span class="badge bg-cream text-dark border">
                                    @user.Bookings.Count() Stay(s)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

