@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Concierge Desk & Reservations";
}

<div class="py-4 bg-cream border-bottom border-gold-subtle">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Bookings</li>
                </ol>
            </nav>
            <h1 class="display-6 font-serif fw-bold mb-0">Concierge Desk & Reservations Management</h1>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Reports" asp-action="Index" class="btn btn-ivory">
                <i class="bi bi-file-earmark-bar-graph me-1"></i> View Reports
            </a>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Filter and Search Bar -->
    <div class="p-3 bg-white rounded border border-gold-subtle shadow-sm mb-4">
        <form asp-controller="Admin" asp-action="Bookings" method="get">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-gold"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search by booking code (AUR-...), guest name, email, or room..." value="@ViewBag.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">All Reservation Statuses</option>
                        <option value="Confirmed" selected="@(ViewBag.SelectedStatus?.ToString() == "Confirmed")">Confirmed</option>
                        <option value="CheckedIn" selected="@(ViewBag.SelectedStatus?.ToString() == "CheckedIn")">Checked-In (In-House)</option>
                        <option value="CheckedOut" selected="@(ViewBag.SelectedStatus?.ToString() == "CheckedOut")">Checked-Out (Completed)</option>
                        <option value="Cancelled" selected="@(ViewBag.SelectedStatus?.ToString() == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-gold w-100">Filter</button>
                    <a asp-controller="Admin" asp-action="Bookings" class="btn btn-ivory" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
                </div>
            </div>
        </form>
    </div>

    <!-- Bookings Table -->
    <div class="p-4 bg-white rounded border border-gold-subtle shadow-sm">
        <div class="table-responsive">
            <table class="table hotel-table mb-0">
                <thead>
                    <tr>
                        <th>Booking Ref</th>
                        <th>Guest Details</th>
                        <th>Suite</th>
                        <th>Stay Itinerary</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th class="text-end">Desk Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var b in Model)
                        {
                            <tr>
                                <td>
                                    <strong class="font-serif fs-6 text-gold-dark">@b.BookingReference</strong>
                                    <small class="text-muted d-block">@b.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@(b.User?.FullName ?? "Grand Guest")</div>
                                    <small class="text-muted">@(b.User?.Email ?? "N/A")</small>
                                    @if (!string.IsNullOrEmpty(b.User?.PhoneNumber))
                                    {
                                        <small class="text-secondary d-block">@b.User.PhoneNumber</small>
                                    }
                                </td>
                                <td>
                                    <strong>Suite @b.Room?.RoomNumber</strong>
                                    <small class="text-muted d-block">@b.Room?.RoomType?.Name</small>
                                </td>
                                <td>
                                    <div class="small fw-semibold">@b.CheckInDate.ToString("MMM dd") – @b.CheckOutDate.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted">@b.TotalNights night(s) • @b.Adults guest(s)</small>
                                </td>
                                <td>
                                    <strong class="text-dark">$@b.TotalPrice.ToString("N2")</strong>
                                    @if (b.Payments.Any(p => p.Status == PaymentStatus.Completed))
                                    {
                                        <span class="badge bg-success-subtle text-success d-block" style="font-size: 0.65rem;">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark d-block" style="font-size: 0.65rem;">Unpaid / Desk</span>
                                    }
                                </td>
                                <td>
                                    @if (b.Status == BookingStatus.Confirmed)
                                    {
                                        <span class="badge badge-booking-confirmed">Confirmed</span>
                                    }
                                    else if (b.Status == BookingStatus.CheckedIn)
                                    {
                                        <span class="badge badge-booking-checkedin">Checked-In</span>
                                    }
                                    else if (b.Status == BookingStatus.CheckedOut)
                                    {
                                        <span class="badge badge-booking-checkedout">Checked-Out</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-booking-cancelled">Cancelled</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Admin" asp-action="BookingDetails" asp-route-id="@b.Id" class="btn btn-ivory btn-sm">
                                        <i class="bi bi-gear me-1"></i> Manage
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No reservations match the current query criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

