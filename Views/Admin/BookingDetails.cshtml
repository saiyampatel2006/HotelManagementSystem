@model Booking
@{
    ViewData["Title"] = $"Manage Reservation - {Model.BookingReference}";
}

<div class="py-4 bg-cream border-bottom border-gold-subtle">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Bookings">Bookings</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.BookingReference</li>
                </ol>
            </nav>
            <h1 class="display-6 font-serif fw-bold mb-0">Manage Reservation: @Model.BookingReference</h1>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Admin" asp-action="Bookings" class="btn btn-ivory btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Desk
            </a>
        </div>
    </div>
</div>

<div class="container py-5 max-w-700">
    <!-- Operational Status Bar & Actions -->
    <div class="p-4 bg-white rounded border border-gold-subtle shadow-sm mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="small text-muted d-block">Current Reservation Status</span>
                @if (Model.Status == BookingStatus.Confirmed)
                {
                    <span class="badge badge-booking-confirmed fs-6">CONFIRMED (Awaiting Check-In)</span>
                }
                else if (Model.Status == BookingStatus.CheckedIn)
                {
                    <span class="badge badge-booking-checkedin fs-6">CHECKED-IN (In Residence)</span>
                }
                else if (Model.Status == BookingStatus.CheckedOut)
                {
                    <span class="badge badge-booking-checkedout fs-6">CHECKED-OUT (Completed)</span>
                }
                else
                {
                    <span class="badge badge-booking-cancelled fs-6">CANCELLED</span>
                }
            </div>

            <!-- Front Desk Action Buttons -->
            <div class="d-flex flex-wrap gap-2">
                @if (Model.Status == BookingStatus.Confirmed)
                {
                    <form asp-controller="Admin" asp-action="CheckInGuest" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bi bi-key-fill me-1"></i> Check-In Guest
                        </button>
                    </form>
                }

                @if (Model.Status == BookingStatus.CheckedIn)
                {
                    <form asp-controller="Admin" asp-action="CheckOutGuest" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Process Check-Out
                        </button>
                    </form>
                }

                @if (Model.Status != BookingStatus.Cancelled && Model.Status != BookingStatus.CheckedOut)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#adminCancelModal">
                        <i class="bi bi-x-circle me-1"></i> Cancel Reservation
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Booking Dossier Information Card -->
    <div class="p-4 p-md-5 bg-white rounded border border-gold-subtle shadow-sm mb-4">
        <h4 class="font-serif fw-bold mb-4 pb-2 border-bottom border-gold-subtle">Guest & Accommodation Particulars</h4>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <small class="text-secondary d-block">Guest Full Name</small>
                <strong class="text-dark fs-6">@(Model.User?.FullName ?? "N/A")</strong>
            </div>
            <div class="col-md-6">
                <small class="text-secondary d-block">Registered Email</small>
                <span class="text-dark">@(Model.User?.Email ?? "N/A")</span>
            </div>
            <div class="col-md-6">
                <small class="text-secondary d-block">Contact Phone</small>
                <span class="text-dark">@(Model.User?.PhoneNumber ?? "N/A")</span>
            </div>
            <div class="col-md-6">
                <small class="text-secondary d-block">Mailing Address</small>
                <span class="text-dark">@(Model.User?.Address ?? "Not specified")</span>
            </div>
        </div>

        <div class="row g-4 mb-4 pt-3 border-top border-gold-subtle">
            <div class="col-md-6">
                <small class="text-secondary d-block">Assigned Suite</small>
                <strong class="text-dark fs-6">Suite @Model.Room?.RoomNumber — @Model.Room?.RoomType?.Name</strong>
                <div class="text-muted small">Floor @Model.Room?.FloorNumber • Max Capacity: @Model.Room?.Capacity</div>
            </div>
            <div class="col-md-6">
                <small class="text-secondary d-block">Party Composition</small>
                <strong class="text-dark">@Model.Adults Adults@(Model.Children > 0 ? $", {Model.Children} Children" : "")</strong>
            </div>
            <div class="col-md-6">
                <small class="text-secondary d-block">Check-In Schedule</small>
                <strong class="text-dark">@Model.CheckInDate.ToString("MMM dd, yyyy")</strong>
                @if (Model.ActualCheckInTime.HasValue)
                {
                    <small class="text-success d-block">Actual: @Model.ActualCheckInTime.Value.ToString("yyyy-MM-dd HH:mm")</small>
                }
            </div>
            <div class="col-md-6">
                <small class="text-secondary d-block">Check-Out Schedule</small>
                <strong class="text-dark">@Model.CheckOutDate.ToString("MMM dd, yyyy")</strong>
                @if (Model.ActualCheckOutTime.HasValue)
                {
                    <small class="text-primary d-block">Actual: @Model.ActualCheckOutTime.Value.ToString("yyyy-MM-dd HH:mm")</small>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.SpecialRequests))
        {
            <div class="p-3 bg-cream rounded border border-gold-subtle mb-4 small">
                <strong class="text-dark">Guest Special Requests:</strong>
                <p class="mb-0 text-secondary">@Model.SpecialRequests</p>
            </div>
        }

        <!-- Financial Summary -->
        <h5 class="font-serif fw-bold mt-4 mb-3">Billing & Transactions</h5>
        <div class="p-3 bg-light rounded border mb-4 small">
            <div class="d-flex justify-content-between mb-1">
                <span>Room Charges (@Model.TotalNights nights @@ $@Model.Room?.PricePerNight.ToString("N2")):</span>
                <span>$@Model.SubTotal.ToString("N2")</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span>Luxury Taxes & State Cess (12%):</span>
                <span>$@Model.TaxAmount.ToString("N2")</span>
            </div>
            <div class="d-flex justify-content-between pt-2 border-top fw-bold fs-6 text-dark">
                <span>Gross Reservation Total:</span>
                <span class="text-gold-dark">$@Model.TotalPrice.ToString("N2")</span>
            </div>
        </div>

        @if (Model.Payments.Any())
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var p in Model.Payments)
                {
                    <div class="p-3 bg-white rounded border d-flex justify-content-between align-items-center small">
                        <div>
                            <strong>@p.PaymentMethod</strong> • Reference: <code>@p.TransactionId</code>
                            <div class="text-muted">Settled on @p.PaymentDate.ToString("MMM dd, yyyy HH:mm")</div>
                        </div>
                        <div class="text-end">
                            <span class="fw-bold text-dark fs-6">$@p.Amount.ToString("N2")</span>
                            <span class="badge bg-success ms-2">@p.Status</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning small mb-0">No payment transaction settled yet.</div>
        }

        @if (Model.Status == BookingStatus.Cancelled)
        {
            <div class="alert alert-danger small mt-4 mb-0">
                <strong>Cancelled:</strong> @Model.CancellationReason
                <small class="d-block text-muted">Cancelled timestamp: @Model.CancelledAt?.ToString("MMM dd, yyyy HH:mm")</small>
            </div>
        }
    </div>
</div>

<!-- Admin Cancellation Modal -->
<div class="modal fade" id="adminCancelModal" tabindex="-1" aria-labelledby="adminCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-gold-subtle">
            <div class="modal-header bg-cream">
                <h5 class="modal-title font-serif fw-bold" id="adminCancelModalLabel">Management Cancellation Override</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="CancelBooking" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body">
                    <p class="text-secondary small mb-3">Cancelling this reservation will initiate automatic payment refunding protocols and release Room #@Model.Room?.RoomNumber for new bookings.</p>
                    <div class="mb-3">
                        <label class="form-label">Administrative Reason</label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="Guest emergency, duplicate entry, maintenance relocation..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ivory" data-bs-dismiss="modal">Keep Active</button>
                    <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>

