@model Payment
@{
    ViewData["Title"] = $"Receipt - {Model.TransactionId}";
}

<div class="py-5 bg-cream border-bottom border-gold-subtle text-center">
    <div class="container py-3">
        <div class="d-inline-flex align-items-center justify-content-center bg-gold-light text-gold-dark rounded-circle p-3 mb-3">
            <i class="bi bi-receipt-cutoff fs-2"></i>
        </div>
        <h1 class="display-5 font-serif fw-bold mt-1">Official Payment Receipt</h1>
        <p class="text-secondary mb-0">Authorized Settlement Voucher & Tax Invoice</p>
    </div>
</div>

<div class="container py-5 max-w-700">
    <div class="p-4 p-md-5 bg-white rounded border border-gold-subtle shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center border-bottom border-gold-subtle pb-3 mb-4">
            <div>
                <span class="font-serif fw-bold fs-4 text-dark text-uppercase">The Aurelia Grand</span>
                <small class="text-secondary d-block">Luxury Hotel & Suites • Financial Services</small>
            </div>
            <div class="text-end">
                <span class="badge bg-success">PAID / SETTLED</span>
            </div>
        </div>

        <div class="row g-3 mb-4 small">
            <div class="col-6">
                <span class="text-muted d-block">Transaction Reference:</span>
                <strong class="font-monospace text-dark">@Model.TransactionId</strong>
            </div>
            <div class="col-6">
                <span class="text-muted d-block">Payment Timestamp:</span>
                <span class="text-dark">@Model.PaymentDate.ToString("MMMM dd, yyyy HH:mm:ss") UTC</span>
            </div>
            <div class="col-6">
                <span class="text-muted d-block">Settlement Method:</span>
                <strong class="text-dark">@Model.PaymentMethod</strong>
            </div>
            <div class="col-6">
                <span class="text-muted d-block">Booking Reference:</span>
                <strong class="text-gold-dark">@(Model.Booking?.BookingReference ?? "N/A")</strong>
            </div>
            <div class="col-6">
                <span class="text-muted d-block">Billed To Guest:</span>
                <strong class="text-dark">@(Model.Booking?.User?.FullName ?? "Grand Guest")</strong>
            </div>
            <div class="col-6">
                <span class="text-muted d-block">Suite Reserved:</span>
                <strong class="text-dark">Suite @Model.Booking?.Room?.RoomNumber (@Model.Booking?.Room?.RoomType?.Name)</strong>
            </div>
        </div>

        <div class="p-4 bg-cream rounded border border-gold-subtle mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="font-serif fw-bold mb-0">Total Amount Settled</h5>
                    <small class="text-secondary">Includes 12% Luxury Goods & Services Tax</small>
                </div>
                <div class="font-serif fs-2 fw-bold text-gold-dark">
                    $@Model.Amount.ToString("N2")
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="p-3 bg-light rounded border small mb-4">
                <strong>Authorization Notes:</strong> @Model.Notes
            </div>
        }

        <div class="text-center text-muted small">
            Thank you for choosing The Aurelia Grand. We eagerly await your arrival.
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 justify-content-center">
        <button type="button" class="btn btn-ivory" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Tax Receipt
        </button>
        <a asp-controller="Bookings" asp-action="Confirmation" asp-route-reference="@Model.Booking?.BookingReference" class="btn btn-gold">
            <i class="bi bi-check2-circle me-1"></i> View Booking Voucher
        </a>
    </div>
</div>

